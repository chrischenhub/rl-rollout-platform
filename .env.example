# Platform settings. Credentials (ANTHROPIC_API_KEY, DAYTONA_API_KEY, DAYTONA_API_URL)
# go in secrets.env, which may use `export KEY=value` lines.

DATABASE_URL=postgresql://rollout:rollout@localhost:5433/rollout
DATA_DIR=./data
# Label on every sandbox; keeps local and droplet janitors out of each other's sandboxes.
ROLLOUT_INSTANCE=local

WORKER_SLOTS=4
MAX_RUNNING=8
LEASE_TTL_SEC=60
HEARTBEAT_SEC=15
MAX_INFRA_RETRIES=2

MODELS=claude-sonnet-5,claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5
# Timezone for times shown in the UI (the API stays in UTC)
DISPLAY_TIMEZONE=America/Los_Angeles

BASE_URL=http://localhost:8000
# Google Workspace domains whose accounts may sign in (checked against the `hd` claim).
ALLOWED_EMAIL_DOMAINS=example.com
# Individual accounts outside those domains, comma-separated (e.g. a personal Gmail for testing).
ALLOWED_EMAILS=
SESSION_SECRET=change-me
# Either the id/secret pair, or the client JSON downloaded from Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_SECRETS_FILE=../client_secret_XXXX.apps.googleusercontent.com.json
